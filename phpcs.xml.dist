<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="StateFlow">
	<description>WordPress coding standards for StateFlow.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tools/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<rule ref="WordPress">
		<!-- StateFlow code lives in the StateFlow\ PSR-4 namespace and cannot
			 collide with WP core globals. -->
		<exclude name="WordPress.WP.EnqueuedResourceParameters"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="StateFlow"/>
				<element value="stateflow"/>
			</property>
		</properties>
		<!-- Test harness artifacts: WP-core constants (WPINC, ABSPATH, WC_VERSION)
			 and the Automattic\ stub namespace are simulated by the harness on
			 purpose, and do_action() receives dynamic hook names. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- PSR-4 filenames (CamelCase class files) are the project layout; the WP
		 filename convention (class-*.php) applies to the plugin distribution
		 build, not the PSR-4 source tree. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/src/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- The test harness intentionally overwrites core globals ($wp_version,
			 $table_prefix) to simulate WordPress; bin/ CLI tooling uses local
			 variables whose names happen to collide with WP globals. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<exclude-pattern>*/bin/*</exclude-pattern>
	</rule>

	<!-- Test bootstrap/tools: direct filesystem access is intentional there
		 (no WordPress runtime available in unit tests / CLI tooling). -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<exclude-pattern>*/bin/*</exclude-pattern>
	</rule>

	<!-- Standalone CLI tooling (bin/): not WordPress runtime code. File-level
		 variables are process-local, output is raw diagnostics, and it shells
		 out to php -l by design. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>*/bin/*</exclude-pattern>
	</rule>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
</ruleset>
