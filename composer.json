{
    "name": "stateflow/stateflow",
    "description": "StateFlow adds an explainable sales-state layer to WooCommerce products and variations without mutating their canonical price or inventory data.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "StateFlow"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "StateFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StateFlow\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "test": [
            "@test:unit",
            "@test:present",
            "@test:matrix"
        ],
        "test:unit": "@php bin/qa.php test:unit",
        "test:present": "@php bin/qa.php test:present",
        "test:matrix": "@php bin/qa.php test:matrix",
        "test:integration": "@php bin/qa.php test:integration",
        "stan": "@php bin/qa.php stan",
        "cs": "@php bin/qa.php cs",
        "cs:fix": "@php bin/qa.php cs:fix",
        "qa": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
