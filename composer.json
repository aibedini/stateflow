{
    "name": "stateflow/stateflow",
    "description": "Order state automation for WooCommerce - engineering foundation (SF-001).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "StateFlow"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "StateFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StateFlow\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "test": [
            "@test:unit",
            "@test:present"
        ],
        "test:unit": "@php vendor/bin/phpunit --testsuite unit",
        "test:present": "@php vendor/bin/phpunit -c phpunit-present.xml.dist",
        "test:integration": "@php vendor/bin/phpunit -c phpunit-integration.xml.dist",
        "stan": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "@php vendor/bin/phpcs",
        "cs:fix": "@php vendor/bin/phpcbf",
        "qa": [
            "@lint",
            "@cs",
            "@stan",
            "@test:unit",
            "@test:present"
        ]
    }
}
